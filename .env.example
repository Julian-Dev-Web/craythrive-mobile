# These values are PUBLIC and are extracted from the app bundle.
# Use the same two names in EAS development, preview and production environments.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Alternatively use EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY for an sb_publishable key.
# Private provider/server credentials belong only in Supabase Edge Function secrets.
